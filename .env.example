# Chave da API da Anthropic (Claude). Sem ela o app roda em "modo demonstração",
# com textos de exemplo montados a partir de modelos prontos.
ANTHROPIC_API_KEY=
# Modelo usado para gerar os posts (opcional).
AI_MODEL=claude-opus-5-5

# Segredo usado para assinar os cookies de uso e de assinatura.
# Gere com: openssl rand -base64 32
SESSION_SECRET=

# Stripe (assinatura do plano Pro). Sem essas chaves o botão de assinar
# mostra um aviso em vez de abrir o checkout.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=

# URL pública do site, usada nos retornos do checkout.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
